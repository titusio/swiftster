# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Media
MEDIA_DIR="/absolute/path/to/your/music"

# The index built by `scripts/index-music.py`. Defaults to songs.json inside
# MEDIA_DIR; set this to keep the index outside the library.
# MEDIA_INDEX="/absolute/path/to/songs.json"

# Dev server — comma-separated hostnames Vite will serve, or `true` to allow any
ALLOWED_HOSTS="localhost,your-machine.your-tailnet.ts.net"
